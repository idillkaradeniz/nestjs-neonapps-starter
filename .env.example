# Copy this file to .env — the app reads it via @nestjs/config (ConfigModule).

# Port the HTTP server listens on (defaults to 3000 if unset).
PORT=3000

# Postgres connection string. NOT wired yet — you connect the database
# on Day 13 (Drizzle ORM). `docker compose up -d` gives you a local Postgres
# that matches this URL.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# Redis connection string. NOT wired yet — caching arrives on Day 19.
# `docker compose up -d` gives you a local Redis that matches this URL.
# REDIS_URL=redis://localhost:6379

# Secret used to sign access-token JWTs (Day 7). Use a long random
# string; never commit the real value.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m

# Separate secret used to sign refresh-token JWTs — deliberately NOT the
# same value as JWT_SECRET, so a leaked access-token secret alone can't
# be used to mint refresh tokens.
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=7d
